+        value=_values(values)[:,self.value_columns]
+        gathered=value[self.neighbors]
+        result=(gathered*self.weights[...,None]).sum(axis=1)/self.denominator[:,None]
+        exact=np.flatnonzero(self.exact_slot>=0)
