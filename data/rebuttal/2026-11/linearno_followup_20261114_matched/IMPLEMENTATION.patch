+def native_idw(source,values,query,k=4,eps=1e-12):
+    source=np.asarray(source);query=np.asarray(query);values=_values(values)
+    k=min(k,len(source))
+    distances,indices=cKDTree(source).query(query,k=k)
+    if k==1:return values[indices]
