+    field=field.reshape(-1,85,85,1)
+    padded=torch.nn.functional.pad(field,(0,0,1,1,1,1),mode='constant',value=0.)
+    dx=(padded[:,1:-1,2:]-padded[:,1:-1,:-2])*(85/2)
+    dy=(padded[:,2:,1:-1]-padded[:,:-2,1:-1])*(85/2)
+    return dx,dy
