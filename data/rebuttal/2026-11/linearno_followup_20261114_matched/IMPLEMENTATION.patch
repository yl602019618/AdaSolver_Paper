+    output=(gathered*weights[...,None]).sum(axis=1)/weights.sum(axis=1)[:,None]
+    exact=distances<=eps;rows=np.flatnonzero(exact.any(axis=1))
+    output[rows]=gathered[rows,np.argmax(exact[rows],axis=1)]
