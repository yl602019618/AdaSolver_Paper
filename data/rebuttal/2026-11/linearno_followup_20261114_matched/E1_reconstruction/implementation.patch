+def car_dual_rel_l2(
+    selected_indices,
+    sampled_prediction_norm,
+    target_phys,
+    positions,
+    surface_mask,
+    output_mean,
+    output_std,
+    *,
+    k: int = 4,
+    pressure_weight: float = 0.5,
+) -> CarFieldMetrics:
+    velocity, pressure, surface_indices = reconstruct_car_fields(
+        selected_indices,
+        sampled_prediction_norm,
+        positions,
+        surface_mask,
+        prediction_is_normalized=True,
+        output_mean=output_mean,
+        output_std=output_std,
+        k=k,
+    )
