+    raise ValueError(architecture)
+
+
+def feature0(model,pos):
+    inputs=pos if isinstance(model,LinearNOAdapter) else torch.cat((pos,pos),dim=-1)
+    hidden=model.net.preprocess(inputs)+model.net.placeholder[None,None,:]
