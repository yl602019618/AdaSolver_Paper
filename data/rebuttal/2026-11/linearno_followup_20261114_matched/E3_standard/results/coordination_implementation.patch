+"""Assemble a local, explicitly scoped E1/E3 extension without remote writes."""
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import zipfile
+
+ROOT = Path(__file__).resolve().parents[1]
+ALLOWED = {'.py', '.md', '.me', '.json', '.jsonl', '.csv', '.tex', '.pdf', '.svg', '.png', '.patch', '.txt', '.yaml', '.yml', '.sh'}
+EXCLUDE = {'__pycache__', 'vendor', 'cache', 'checkpoints', 'data', 'logs', 'runtime'}
+
+
+def read(path):
+    return json.loads(path.read_text()) if path.exists() else {}
+
+
+def hash_file(path):
+    digest = hashlib.sha256()
+    with path.open('rb') as f:
+        for block in iter(lambda: f.read(8 * 1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--allow-partial', action='store_true')
+    parser.add_argument('--zip', action='store_true')
+    args = parser.parse_args()
+    standard = read(ROOT / 'standard_benchmarks/results/collection_status.json')
+    car = read(ROOT / 'reconstruction/results/car_delivery_receipt.json')
+    qa = read(ROOT / 'coordination/render_qa.json')
+    numeric_complete = standard.get('accuracy_complete') and standard.get('latency_complete') and car.get('execution_status') == 'completed'
+    complete = bool(numeric_complete and qa.get('passed'))
+    if not args.allow_partial and not complete:
+        raise RuntimeError('Final archive requires complete standard/Car matrices and actual rendered QA')
+    target = ROOT / 'archive_ready'
+    target.mkdir(exist_ok=True)
+    copied, pointers = [], []
+    seen_targets = set()
+    for source, section in [(ROOT / 'reconstruction', 'E1_reconstruction'),
+                            (ROOT / 'standard_benchmarks', 'E3_standard')]:
+        for path in sorted(source.rglob('*')):
+            relative = path.relative_to(source)
+            if not path.is_file() or any(part in EXCLUDE for part in relative.parts):
+                continue
+            if path.suffix not in ALLOWED and path.name != 'read.me':
+                continue
+            if path.stat().st_size > 64 * 1024 * 1024:
+                pointers.append(dict(path=str(path), bytes=path.stat().st_size, sha256=hash_file(path), reason='large raw record; kept at internal path'))
+                continue
+            destination = target / section / relative
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(path, destination)
+            seen_targets.add(destination)
+            copied.append(dict(archive_path=str(destination.relative_to(target)), source=str(path), bytes=path.stat().st_size, sha256=hash_file(destination)))
+    # Checkpoints and caches stay internal. Their manifests preserve identities,
+    # recorded costs and the exact original paths without copying weight payloads.
+    for task in ['darcy', 'airfoil']:
+        folder = ROOT / 'standard_benchmarks' / task
+        for manifest in (folder / 'checkpoints').glob('**/manifest.json'):
+            value = read(manifest)
+            pointers.append(dict(manifest=str(manifest), manifest_sha256=hash_file(manifest),
+                checkpoint=value.get('checkpoint', value.get('head_checkpoint')),
+                checkpoint_sha256=value.get('checkpoint_sha256', value.get('head_sha256')),
+                normalizer=value.get('normalizer'), normalizer_sha256=value.get('normalizer_sha256'),
+                execution_status=value.get('execution_status'), reason='weights remain internal'))
+        pointers.append(dict(path=str(folder / 'cache'), reason='training caches remain internal'))
+        pointers.append(dict(path=str(folder / 'records'), reason='full arrays remain internal; per-case metrics and hashes are included'))
+        pointers.append(dict(path=str(folder / 'logs'), reason='large training logs remain internal; cost summaries and manifests are included'))
+    for name in ['PLAN.md', 'protocol_lock.json', 'source_registry.json', 'source_diff_summary.md',
+                 'legacy_car_checkpoint_verification.json', 'darcy_independent_code_review.md']:
+        source = ROOT / 'coordination' / name
+        if source.exists():
+            destination = target / 'coordination' / name
+            destination.parent.mkdir(exist_ok=True)
+            shutil.copy2(source, destination)
+            copied.append(dict(archive_path=str(destination.relative_to(target)), source=str(source), bytes=source.stat().st_size, sha256=hash_file(destination)))
+    now = dt.datetime.now(dt.timezone.utc).isoformat()
+    manifest = dict(created_at_utc=now, complete=complete, numeric_complete=bool(numeric_complete),
+        status='complete_local_package' if complete else 'partial_local_package',
+        standard_state=standard, car_state=car, render_qa=qa or 'pending',
+        historical_release_preserved='91c1fa7cc81b8c1cb61a43618296c1c892d818c0',
+        remote_push=False, files=copied, internal_artifacts=pointers)
+    (target / 'archive_manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
+    (target / 'README.md').write_text('# LinearNO follow-up local package\n\n'
+        f'Status: {manifest["status"]}. Generated {now}.\n\n'
+        '`E1_reconstruction/` contains the new reconstruction implementation, rules, correctness records, costs and figures when available. '
+        '`E3_standard/` contains the new matched Darcy/Airfoil protocols, raw metrics, independent statistics and paper tables/figures when available. '
+        'Missing matrices remain pending and are listed in archive_manifest.json.\n\n'
+        'Weights, full prediction arrays, caches and large logs remain at the internal paths in the manifest. '
+        'Task commands in each protocol/COMMANDS document run from the original development workspace and require the recorded datasets and source dependencies. '
+        'Official LinearNO source is pinned in the source registry; no LICENSE metadata was found, and its vendored source is not bundled here.\n\n'
+        'The old E1/E3 release and current manuscript are preserved. This package is local; no GitHub push or Feishu write is performed.\n')
+    if args.zip:
+        zip_path = ROOT / ('linearno_followup_20261114_complete.zip' if complete else 'linearno_followup_20261114_partial.zip')
+        with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED, compresslevel=6) as z:
+            for path in sorted(target.rglob('*')):
+                if path.is_file():
+                    z.write(path, arcname=str(Path('linearno_followup_20261114') / path.relative_to(target)))
+        print(json.dumps(dict(path=str(zip_path), bytes=zip_path.stat().st_size, sha256=hash_file(zip_path), complete=complete)))
+    else:
+        print(json.dumps(dict(path=str(target), included_files=len(copied), complete=complete)))
+
+
+if __name__ == '__main__':
+    main()
