+"""Refresh the shared status from live manifests; never infer completed evidence."""
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import fcntl
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+import traceback
+
+ROOT = Path(__file__).resolve().parents[1]
+READ_CACHE = {}
+
+
+def read(path):
+    path = Path(path)
+    for attempt in range(5):
+        try:
+            value = json.loads(path.read_text())
+            READ_CACHE[str(path)] = value
+            return value
+        except FileNotFoundError:
+            return {}
+        except (OSError, json.JSONDecodeError) as error:
+            warning = str(error)
+            time.sleep(.1 * (attempt + 1))
+    return {**READ_CACHE.get(str(path), {}), 'observation_warning': warning}
+
+
+def last_history(path):
+    try:
+        with Path(path).open('rb') as f:
+            f.seek(max(0, Path(path).stat().st_size - 8192))
+            lines = f.read().splitlines()
+        return next(json.loads(line) for line in reversed(lines) if line.startswith(b'{'))
+    except (OSError, ValueError, StopIteration):
+        return {}
+
+
+def atomic(path, value):
+    path = Path(path)
+    temp = path.with_name(path.name + f'.{os.getpid()}.tmp')
+    temp.write_text(value)
+    temp.replace(path)
+
+
+def refresh():
+    now = dt.datetime.now(dt.timezone.utc).isoformat()
+    state = {'updated_at_utc': now, 'tasks': {}, 'external_writes': 'not authorized for this follow-up'}
+    lines = [f'LinearNO follow-up status — {now}', '',
+             'Local work only. No remote push, main overwrite or Feishu write.', '',
+             'Model training and final accuracy/timing acceptance are separate states.', '']
+    for dataset in ('airfoil', 'darcy'):
+        base = ROOT / 'standard_benchmarks' / dataset
+        tasks = {}
+        for path in sorted((base / 'runtime').glob('*workflow.json')):
+            tasks[path.name] = read(path)
+        state['tasks'][dataset] = tasks
+        models = ['t3', 'linearno', 'linearno_conv'] if dataset == 'airfoil' else ['transolver3', 'linearno', 'linearno_conv']
+        for arch in models:
+            meta = read(base / 'checkpoints' / arch / 'manifest.json')
+            history = last_history(base / 'checkpoints' / arch / 'history.jsonl')
+            workflow = tasks.get(arch + '_workflow.json', {})
+            completed = history.get('epoch', -1) + 1 if history else meta.get('epochs_completed', 0)
+            best = meta.get('best_validation_relative_l2', history.get('best_validation'))
+            stages = read(base / 'runtime' / f'{arch}_head_substages.json')
+            head = read(base / 'checkpoints' / arch / 'head' / 'manifest.json')
+            acceptance = read(base / 'results' / f'{arch}_accuracy_acceptance.json')
+            detail = {'epochs_completed': completed, 'best_validation_relative_l2': best,
+                      'workflow': workflow.get('execution_status', 'pending'),
+                      'active_stage': stages.get('active_stage') or workflow.get('active_stage'),
+                      'head_epochs_completed': head.get('epochs_completed', 0),
+                      'final_accuracy_accepted': acceptance.get('passed', False)}
+            state['tasks'][dataset][arch + '_progress'] = detail
+            lines.append(f"{dataset}/{arch}: {completed}/1000 backbone epochs; {detail['workflow']}; "
+                         f"stage={detail['active_stage']}; final accuracy accepted={detail['final_accuracy_accepted']}.")
+        receipt = read(base / 'results' / 'latency_completion.json')
+        lines.append(f"{dataset} formal timing: {receipt.get('actual_conditions', 0)}/1323 conditions, "
+                     f"{receipt.get('actual_formal_repeats', 0)}/132300 repetitions.")
+        lines.append('')
+    state['tasks']['reconstruction'] = read(ROOT / 'reconstruction/runtime/car_workflow.json')
+    state['reconstruction_gate'] = read(ROOT / 'reconstruction/accepted_protocols.json')
+    car = state['tasks']['reconstruction']
+    lines += [f"Car workflow: {car.get('execution_status', 'pending')}; stage={car.get('active_stage')}.",
+              'Shared reconstruction API v1.1 has numeric equivalence receipts. Each newly trained model still requires its own end-to-end validation.',
+              'Formal latency is measured after exclusive GPU admission; CPU diagnostic profiles are not end-to-end speedup evidence.', '',
+              'Protocols and resource plan: coordination/PLAN.md; dataset read.me files retain detailed stage counts.',
+              'Cross-dataset tables and figures require raw-record independent aggregation and rendered QA.', '']
+    try:
+        state['gpu_snapshot'] = subprocess.check_output(
+            ['nvidia-smi', '--query-gpu=index,name,utilization.gpu,memory.used,memory.total', '--format=csv'],
+            text=True, timeout=10)
+    except (OSError, subprocess.SubprocessError) as error:
+        state['gpu_snapshot_error'] = str(error)
+    atomic(ROOT / 'coordination/status_snapshot.json', json.dumps(state, indent=2) + '\n')
+    atomic(ROOT / 'read.me', '\n'.join(lines))
+    return state
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--watch', action='store_true')
+    args = parser.parse_args()
+    with (ROOT / 'coordination/status_monitor.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        while True:
+            try:
+                refresh()
+            except OSError:
+                traceback.print_exc()
+                if not args.watch:
+                    raise
+            if not args.watch:
+                break
+            time.sleep(45)
