+output=OUT/'data';output.mkdir(exist_ok=True)
+records=[];started=time.perf_counter()
+for kind,filename,count in [('pool','piececonst_r421_N1024_smooth1.mat',1000),('test','piececonst_r421_N1024_smooth2.mat',200)]:
+    p=source/filename
