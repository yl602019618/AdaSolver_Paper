+    k=torch.softmax(logits+log,dim=-2)
+    kv=torch.einsum('bhnd,bhnc->bhdc',k,v)
+    output=torch.einsum('bhnd,bhdc->bhnc',q,kv)
+    return self.to_out(rearrange(output,'b h n d -> b n (h d)'))
