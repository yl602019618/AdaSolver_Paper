+                optimizer.zero_grad(set_to_none=True);loss.backward();torch.nn.utils.clip_grad_norm_(model.parameters(),.1);optimizer.step();scheduler.step();total+=loss.detach()*len(ids)
+            model.eval();values=[]
+            with torch.no_grad():
