+    normalizer_sha256=digest(output/'normalizer.npz'),normalizer_statistics={k:v.tolist() for k,v in normalizer.items()},
+    shared_split_sha256=digest(FOLLOWUP/'standard_benchmarks/split_manifest.json'),
